# Copy this file to ".env" and set your own values. NEVER commit ".env".

PORT=3001

# Admin login (full access). Choose a strong password (8+ characters).
ADMIN_USERNAME=Vidanshu
ADMIN_PASSWORD=Vidanshu@123

# Optional second login for staff (can only see Dashboard, Orders, Inquiries). Leave blank to disable.
EXEC_USERNAME=executive
EXEC_PASSWORD=

# Long random text used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where orders/inquiries are saved (use a persistent disk in production).
DATA_FILE=data/db.json
